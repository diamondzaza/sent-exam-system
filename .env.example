# ═══════════════════════════════════════════════════════════
# ตัวแปรสภาพแวดล้อม — ระบบจัดส่งและจัดพิมพ์ข้อสอบ
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (.env.local ไม่ถูก commit)
# ═══════════════════════════════════════════════════════════

# ── Supabase (เมื่อพร้อมเชื่อมต่อ — ดู supabase/README.md) ──
# Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — ข้าม RLS ทั้งหมด! ใช้เฉพาะฝั่ง server (API routes) เท่านั้น
# ห้ามตั้งค่านี้ด้วยตัวแปรที่ขึ้นต้น NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
